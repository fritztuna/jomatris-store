# Copy this file to .env and fill in what you have. Anything left blank
# simply runs that feature in DEMO MODE (safe to test, no real charges).

PORT=3000

# Comma-separated list of origins allowed to call this API from a browser.
# Leave blank while developing locally.
ALLOWED_ORIGINS=

# ---- DPO Group (Direct Pay Online) -----------------------------------------
# Sign up at https://dpogroup.com — once approved they issue a Company Token
# and a Service Type code for your account.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=

# ---- Stripe -----------------------------------------------------------------
# Only usable once you have a Stripe account Stripe will actually approve for
# your business (see the comment at the top of src/payments/stripe.js).
STRIPE_SECRET_KEY=

# ---- Bank transfer / EFT details, shown to customers who choose that option -
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=

# ---- WhatsApp order fallback -------------------------------------------------
# Number in international format, no + or spaces, e.g. 264814149332
WHATSAPP_NUMBER=264814149332

# ---- Sessions / accounts -----------------------------------------------------
# NODE_ENV controls whether the login session cookie requires HTTPS. Leave
# this unset for local development (http://localhost) — the cookie is set to
# require HTTPS automatically once you deploy with NODE_ENV=production.
NODE_ENV=
